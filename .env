# ---------- Образы ----------
OLLAMA_IMAGE_TAG=0.40.3
QDRANT_IMAGE_TAG=v1.13.4

# ---------- LLM (Ollama) ----------
# Адрес Ollama внутри docker-сети
OLLAMA_URL=http://ollama:11434
# Ollama не имеет встроенной авторизации; ключ отправляется как Bearer,
# если Ollama стоит за прокси с авторизацией. Оставьте пустым, если не нужен.
OLLAMA_API_KEY=
# Модели эмбеддингов для тестирования, через запятую. Первая — модель по умолчанию.
# Все модели скачиваются при старте (контейнер ollama-pull); в UI можно выбрать любые из них.
# Примеры: nomic-embed-text, mxbai-embed-large, bge-m3, all-minilm
OLLAMA_EMBED_MODELS=hotchpotch/bekko-embedding-v1-a25m:q8_0,nomic-embed-text
# Сколько держать модель в памяти после запроса
OLLAMA_KEEP_ALIVE=10m
# Лимит CPU для контейнера Ollama (ядра, можно дробное).
# Число потоков инференса (num_thread) по умолчанию = OLLAMA_CPUS, округлённое вниз.
OLLAMA_CPUS=4
# Переопределение числа потоков; пусто = брать из OLLAMA_CPUS
OLLAMA_NUM_THREAD=
OLLAMA_PORT=11434

# ---------- Векторная БД (Qdrant) ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-qdrant-key
# Префикс коллекции; к нему добавляется имя модели (разные модели = разная размерность)
QDRANT_COLLECTION=embeddings
QDRANT_HTTP_PORT=6333

# ---------- Сервис ----------
API_PORT=8080
# Размер чанка в символах и перекрытие
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
# Сколько чанков отправлять в Ollama одним запросом
EMBED_BATCH_SIZE=16
# Макс. размер загружаемых файлов (байт) для бенчмарка
MAX_UPLOAD_BYTES=209715200
